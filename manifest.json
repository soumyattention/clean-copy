{
  "manifest_version": 3,
  "name": "Clean Copy \u2014 for X",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "description": "Copy X links. Leave the extra parameters behind. A tiny check confirms every clean copy.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean Copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "cleaner.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
